# Default: DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: use any OpenAI-compatible model instead (a cloud provider, or a local server such as Ollama or vLLM)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=your-model-name
# LLM_API_KEY=your_key_or_any_value_for_local_servers

# Optional: only affects walking-time lookups
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
